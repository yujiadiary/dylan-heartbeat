# ============ 上游模型（Kelivo / 网页对话 / 自动唤醒 共用同一份）============
# DeepSeek 官方填：https://api.deepseek.com/chat/completions
TARGET_API_URL=https://api地址/v1/chat/completions
TARGET_API_KEY=你的APIKey
# DeepSeek 填：deepseek-chat（V3）或 deepseek-reasoner（R1）
MODEL_NAME=你的模型名称
# 公网访问网关时使用的长随机Key（仅 ALLOW_PUBLIC_API=true 时需要）
GATEWAY_API_KEY=公网访问网关时使用的长随机Key

# ============ 推送 ============
BARK_KEY=你的BarkKey
CUSTOM_ICON_URL=https://你的图标URL（可选）
PUSH_PROVIDER=bark
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=
NTFY_PRIORITY=
NTFY_TAGS=

# ============ 网页对话（webchat，本 fork 新增）============
# webchat-server.js 的端口（手机浏览器访问 http://电脑IP:3001/webchat）
WEBCHAT_PORT=3001
# 回复生成后，若你已离开页面（20秒没有轮询），用 Bark 提醒「网页上有新回复」
WEBCHAT_BARK_NOTIFY=true
# 网页对话里显示的双方名字
WEBCHAT_USER_NAME=加加
WEBCHAT_AI_NAME=江予朔

# ============ 自动唤醒节奏 ============
# 白天/夜间：距离你最后一条消息多久后允许唤醒（分钟）
DAY_WAKE_AFTER_MINUTES=60
NIGHT_WAKE_AFTER_MINUTES=120
# 白天/夜间：后台多久检查一次是否该唤醒（分钟）
DAY_CHECK_INTERVAL_MINUTES=10
NIGHT_CHECK_INTERVAL_MINUTES=120
# 白天时段（10:00-24:00 之外按夜间策略）
WAKE_DAY_START_HOUR=10
WAKE_DAY_END_HOUR=24

# ============ 天气注入（可选，Open-Meteo 免费无Key）============
WEATHER_ENABLED=false
WEATHER_LOCATION_NAME=Beijing
WEATHER_LAT=
WEATHER_LON=
WEATHER_UNITS=metric

# ============ 日记 ============
DIARY_ENABLED=true
DIARY_DIR=diary
DATA_DIR=
PUSH_TIMEOUT_MS=15000
WAKE_UPSTREAM_TIMEOUT_MS=300000
REQUEST_BODY_LIMIT_MB=50
MULTIMODAL_MODE=passthrough

# ============ 服务 ============
PORT=3000
GATEWAY_BASE_URL=http://localhost:3000
TIME_ZONE=Asia/Shanghai
RESTART_COMMAND=pm2 restart gateway wake-up --update-env
ADMIN_USER=admin
ADMIN_PASSWORD=你的强密码
